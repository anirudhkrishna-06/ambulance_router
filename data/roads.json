  "traffic_patterns": {
    "peak_morning": {
      "time": "07:00-10:00",
      "affected_roads": [
        "arterial",
        "commercial",
        "highway"
      ],
      "multiplier": 2.5
    },
    "peak_evening": {
      "time": "17:00-20:00",
      "affected_roads": [
        "arterial",
        "commercial",
        "it_corridor"
      ],
      "multiplier": 3.0
    },
    "weekend_leisure": {
      "time": "weekend",
      "affected_roads": [
        "coastal",
        "coastal_highway",
        "recreational"
      ],
      "multiplier": 1.8
    },
    "night_emergency": {
      "time": "22:00-06:00",
      "affected_roads": [
        "emergency"
      ],
      "multiplier": 0.5
    }
  },
  "openstreetmap_integration": {
    "queries": {
      "hospitals": {
        "overpass_query": "[out:json][timeout:25];(node[\"amenity\"=\"hospital\"](bbox);way[\"amenity\"=\"hospital\"](bbox);relation[\"amenity\"=\"hospital\"](bbox););out geom;",
        "update_frequency": "weekly"
      },
      "emergency_services": {
        "overpass_query": "[out:json][timeout:25];(node[\"emergency\"~\".*\"](bbox);way[\"emergency\"~\".*\"](bbox););out geom;",
        "update_frequency": "daily"
      },
      "roads": {
        "overpass_query": "[out:json][timeout:60];(way[\"highway\"~\"^(motorway|trunk|primary|secondary|tertiary)$\"](bbox););out geom;",
        "update_frequency": "monthly"
      },
      "traffic_signals": {
        "overpass_query": "[out:json][timeout:25];(node[\"highway\"=\"traffic_signals\"](bbox););out geom;",
        "update_frequency": "monthly"
      }
    },
    "bbox": {
      "south": 12.7,
      "west": 79.9,
      "north": 13.3,
      "east": 80.4
    }
  },
  "algorithms": {
    "a_star": {
      "heuristic": "haversine_distance",
      "cost_function": "distance + traffic_delay + hospital_priority_bonus",
      "emergency_mode": {
        "ignore_traffic": false,
        "priority_lanes": true,
        "signal_override": true
      }
    },
    "dijkstra": {
      "fallback": true,
      "use_case": "when destination hospital not specified"
    },
    "dynamic_routing": {
      "real_time_traffic": true,
      "road_closure_detection": true,
      "alternative_route_calculation": 3
    }
  },
